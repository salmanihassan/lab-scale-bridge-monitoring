var getCamelCasedInstance = function(instance){
	var instanceName;
	switch (instance) {
    case "MMC1":
        instanceName = "Mmc1";
        break;
	case "MMC2":
        instanceName = "Mmc2";
        break;
	case "MMC3":
        instanceName = "Mmc3";
        break;  
	case "MMC4":
        instanceName = "Mmc4";
        break;  	
	}
	return instanceName;
};

// funtion to format MMC modes string based on mmcMode table, and convert them to dts standards (i.e. lowecase, underscore)
var formatModeString = function(modeString, isManualMode){

	modeString = modeString.toLowerCase();
	
	var instanceName;
	var modeStringFormatted = '';

	if(modeString.search("mmc1") !== -1){
		modeStringFormatted = modeString.replace("mmc1", "");
		
		modeStringFormatted = "mmc1" + "_pins_" + modeStringFormatted;
		 
	}else if(modeString.search("mmc2") !== -1){
		modeStringFormatted = modeString.replace("mmc2", "");
		
		modeStringFormatted = "mmc2" + "_pins_" + modeStringFormatted;
		 
	}else if(modeString.search("mmc3") !== -1){
		modeStringFormatted = modeString.replace("mmc3", "");
		
		modeStringFormatted = "mmc3" + "_pins_" + modeStringFormatted;
		 
	}else if(modeString.search("mmc4") !== -1){
		modeStringFormatted = modeString.replace("mmc4", "");
		
		modeStringFormatted = "mmc4" + "_pins_" + modeStringFormatted;
	}else if(modeString.search("dcan1") !== -1){
		modeStringFormatted = modeString.replace("dcan1", "");
		
		modeStringFormatted = "dcan1" + "_pins_" + modeStringFormatted;
		
	}else if(modeString.search("dcan2") !== -1){
		modeStringFormatted = modeString.replace("dcan2", "");
		
		modeStringFormatted = "dcan2" + "_pins_" + modeStringFormatted;
		
	}
	
	if(isManualMode){
		modeStringFormatted = modeStringFormatted.replace("_pins_", "_iodelay_");
	}
	
	//add underscore to pad/internal loopback at the end
	if(modeStringFormatted.search("plb") !== -1){
		modeStringFormatted = modeStringFormatted.replace("plb", "_plb");
	}else if(modeStringFormatted.search("ilb") !== -1){
		modeStringFormatted = modeStringFormatted.replace("ilb", "_ilb");
	}
	
	return modeStringFormatted;
};

// function to return the name of the assocaited padconf register
var getPadConfRegName = function (assignment) {
	
	//console.log (mainDB.length);
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			return pad.type.pad.confregisters.regbit.register;
		
		}
	}

	return "NA";
};

// function to return an array of all associated manual modes for the selected muxmode
var getManualModes = function (assignment) {
	var manualModes = [];
	
	//console.log (mainDB.length);
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			var muxModes = pad.type.pad.muxmode;
			
			for( var j = 0; j < muxModes.length; j++ ) {
			
				var muxMode = muxModes[j];
				
				if(muxMode.mode === assignment.muxMode){
					
					if(muxMode.hasOwnProperty('manualmode')){
						
						//aways return an array, if not an Array then it is an object so we push it into an array then return
						if(!Array.isArray(muxMode.manualmode)){
							manualModes.push(muxMode.manualmode);	
							return manualModes;
						}
						else{
							return muxMode.manualmode;
						}
					}
				}
			}
		}
	}
	//console.log ("_________________")
	//console.log (mainDB)
	return manualModes;
};

// same as getManualModes, but is matching altMuxMode number if it is configured
var getManualModesAltMode = function (assignment, altMuxSignal, altMuxMode) {
	var manualModes = [];
	
	//console.log (mainDB.length);
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			var muxModes = pad.type.pad.muxmode;
			
			for( var j = 0; j < muxModes.length; j++ ) {
			
				var muxMode = muxModes[j];
				
				//patch for pruss gpi/gpo signals mapped to pru_r31/pru_r30 internal signals
				//if found in assignment name replace by internal pruss naming convention
				if((altMuxSignal.indexOf("_pru") > -1) && (altMuxSignal.indexOf("_gpi") > -1)){
					altMuxSignal = altMuxSignal.replace("_gpi", "_pru_r31_in");
				}else if((altMuxSignal.indexOf("_pru") > -1) && (altMuxSignal.indexOf("_gpo") > -1)){
					altMuxSignal = altMuxSignal.replace("_gpo", "_pru_r30_out");
				}
				
				if(muxMode.mode === altMuxMode){

					if(muxMode.hasOwnProperty('additionalMux')){
						
						var values = muxMode.additionalMux.confregisters.value;
						var valuesArray = [];
						
						//makeValues always an array
						if(!Array.isArray(values)){
							valuesArray.push(values);	
						}else{
							valuesArray = values;
						}
						
						for ( var k = 0; k < valuesArray.length; k++){
							var value = valuesArray[k];
							
							if(value.hasOwnProperty('manualmode') && value.signal === altMuxSignal){
								
								//aways return an array, if not an Array then it is an object so we push it into an array then return
								if(!Array.isArray(value.manualmode)){
									manualModes.push(value.manualmode);	
									return manualModes;
								}
								else{
									return value.manualmode;
								}
							}
						}
						
					}else{
						console.log("ERROR: Alternate MuxMode is configured for " + muxMode.signal + " but cannot find 'additionalMux' in main DB.");
					}
				}
			}
		}
	}
	//console.log ("_________________")
	//console.log (mainDB)
	return manualModes;
};

// function to return an array of all associated virtual modes for the selected muxmode
var getVirtualModes = function (assignment) {
	var virtualModes = [];
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			var muxModes = pad.type.pad.muxmode;
			
			for( var j = 0; j < muxModes.length; j++ ) {
			
				var muxMode = muxModes[j];
				
				if(muxMode.mode === assignment.muxMode){
					
					if(muxMode.hasOwnProperty('virtualmode')){
						
						//aways return an array, if not an Array then it is an object so we push it into an array then return
						if(!Array.isArray(muxMode.virtualmode)){
							virtualModes.push(muxMode.virtualmode);	
							return virtualModes;
						}
						else{
							return muxMode.virtualmode;
						}
					}
				}
			}
		}
	}
	
	return virtualModes;
};

// same as getManualModesAltMode, but is matching altMuxMode number if it is configured
var getVirtualModesAltMode = function (assignment, altMuxSignal, altMuxMode) {
	var virtualModes = [];
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			var muxModes = pad.type.pad.muxmode;
			
			for( var j = 0; j < muxModes.length; j++ ) {
			
				var muxMode = muxModes[j];
				
				//patch for pruss gpi/gpo signals mapped to pru_r31/pru_r30 internal signals
				//if found in assignment name replace by internal pruss naming convention
				if((altMuxSignal.indexOf("_pru") > -1) && (altMuxSignal.indexOf("_gpi") > -1)){
					altMuxSignal = altMuxSignal.replace("_gpi", "_pru_r31_in");
				}else if((altMuxSignal.indexOf("_pru") > -1) && (altMuxSignal.indexOf("_gpo") > -1)){
					altMuxSignal = altMuxSignal.replace("_gpo", "_pru_r30_out");
				}
				
				
				if(muxMode.mode === altMuxMode){

					if(muxMode.hasOwnProperty('additionalMux')){
						
						var values = muxMode.additionalMux.confregisters.value;
						var valuesArray = [];
						
						//makeValues always an array
						if(!Array.isArray(values)){
							valuesArray.push(values);	
						}else{
							valuesArray = values;
						}
						
						for ( var k = 0; k < valuesArray.length; k++){
							var value = valuesArray[k];
							
							if(value.hasOwnProperty('virtualmode') && value.signal === altMuxSignal){
								
								//aways return an array, if not an Array then it is an object so we push it into an array then return
								if(!Array.isArray(value.virtualmode)){
									virtualModes.push(value.virtualmode);	
									return virtualModes;
								}
								else{
									return value.virtualmode;
								}
							}
						}
						
					}else{
						console.log("ERROR: Alternate MuxMode is configured for " + muxMode.signal + " but cannot find 'additionalMux' in main DB.");
					}
				}
			}
		}
	}
	
	return virtualModes;
};

var getAddress = function( assignment ) {
	return ( assignment.devicePin.controlRegisterOffset).toString( 16 );
};

var getResetRegisterValue = function ( assignment ){

	var MUXMODE = (parseInt(assignment.muxMode)).toString(16);
	MUXMODE = MUXMODE.toUpperCase();
	var DELAYMODE = "0"; 	//string hex values 0x0 4 bits
	var MODESELECT = "00";  //string hex values 0x00 8 bits (modeselect + reserved bits [8:15])
	var PULLUDENABLE = "0";
	var PULLTYPESELECT = "0";
	var INPUTENABLE = "0";
	var SLEWCONTROL = "0";
	

	if (assignment.pd == false && assignment.pu == false) {
		// if pull up and pull down are not used, set weak pull up/down to 0x1 - disable
		PULLUDENABLE = "1";
	}
	else {
		PULLUDENABLE = "0";
	}
	
	
	
	if (assignment.pd == true){
		PULLTYPESELECT = "0";
	}
	else if(assignment.pu == true){
		PULLTYPESELECT = "1";
	}
	else {
		PULLTYPESELECT = "0";
	}
	
	if (assignment.rx == true){
		INPUTENABLE = "1";
	}
	else if(assignment.rx == false){
		INPUTENABLE = "0";
	}
	
	
	// if offset is one of the 37 register, set to slow slew (0x1)
	if((assignment.devicePin.controlRegisterOffset in slewControlFast) || (assignment.slow_slew_rate == true)){
		SLEWCONTROL = "1";
	}
	
	var PULLstring = SLEWCONTROL + INPUTENABLE + PULLTYPESELECT + PULLUDENABLE;
	var PULLbin = parseInt(PULLstring, 2);
	var PULLhex = PULLbin.toString(16).toUpperCase();
		
	

	// returning register value MSB first	
	return "0x" + PULLhex + MODESELECT + DELAYMODE + MUXMODE;
}; 

// same as getResetRegisterValue, but needs to calculate muxmode based on alternate muxing (i.e. not the assignment.muxmode which is indexed 17 and higher)
var getResetRegisterValueAltMode = function ( assignment, altMuxMode ){

