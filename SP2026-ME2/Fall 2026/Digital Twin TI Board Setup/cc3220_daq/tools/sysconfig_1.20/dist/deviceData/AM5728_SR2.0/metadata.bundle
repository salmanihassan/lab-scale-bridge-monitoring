	DELAYMODE = DELAYMODE.toUpperCase();
	
	var MODESELECT = "01";  //string hex values 0x00 8 bits (modeselect + reserved bits [8:15])
	var PULLUDENABLE = "0";
	var PULLTYPESELECT = "0";
	var INPUTENABLE = "0";
	var SLEWCONTROL = "0";
	

	if (assignment.pd == false && assignment.pu == false) {
		// if pull up and pull down are not used, set weak pull up/down to 0x1 - disable
		PULLUDENABLE = "1";
