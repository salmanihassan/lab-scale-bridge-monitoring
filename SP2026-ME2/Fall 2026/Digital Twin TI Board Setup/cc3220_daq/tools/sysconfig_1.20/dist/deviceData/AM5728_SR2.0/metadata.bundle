function strEndsWith(str, end) {
    return str.match(end+"$")==end;
};

// function to return an array of all associated alternate mode data based on a gived assignment
var getAlternateModes = function (assignment) {
	var alternateModes = {};
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			var muxModes = pad.type.pad.muxmode;
			
			for( var j = 0; j < muxModes.length; j++ ) {
			
				var muxMode = muxModes[j];
				
				if(muxMode.hasOwnProperty('additionalMux')){
					var confregisters = muxMode.additionalMux.confregisters;
					
					var values = confregisters.value;
					if(Array.isArray(values)){
						for(var v = 0; v < values.length; v++){
							
							var value = values[v];
							var assignmentName = assignment.peripheralPin.name;
							
							//patch for pruss gpi/gpo signals mapped to pru_r31/pru_r30 internal signals
							//if found in assignment name replace by internal pruss naming convention
							if((assignmentName.indexOf("_pru") > -1) && (assignmentName.indexOf("_gpi") > -1)){
								assignmentName = assignmentName.replace("_gpi", "_pru_r31_in");
							}else if((assignmentName.indexOf("_pru") > -1) && (assignmentName.indexOf("_gpo") > -1)){
								assignmentName = assignmentName.replace("_gpo", "_pru_r30_out");
							}
							
							if(value.signal === assignmentName){
								alternateModes["register"] = confregisters.register;
								alternateModes["muxMode"] = muxMode.mode;
								alternateModes["fieldPos"] =  value.fieldPos;
								alternateModes["value"] = value.option;
								alternateModes["signal"] = assignmentName;
							
								
								if(value.hasOwnProperty('additional_option')){
									var additionalOption = {};
									
									additionalOption["fieldPos"] = value.additional_option.fieldPos;
									additionalOption["value"] = value.additional_option.option;
									
									alternateModes["additionalOption"] = additionalOption;
								}
							}
							
						}
					}else{
						var value = values;
						var assignmentName = assignment.peripheralPin.name;
						
						//patch for pruss gpi/gpo signals mapped to pru_r31/pru_r30 internal signals
						//if found in assignment name replace by internal pruss naming convention
						if((assignmentName.indexOf("_pru") > -1) && (assignmentName.indexOf("_gpi") > -1)){
							assignmentName = assignmentName.replace("_gpi", "_pru_r31_in");
						}else if((assignmentName.indexOf("_pru") > -1) && (assignmentName.indexOf("_gpo") > -1)){
							assignmentName = assignmentName.replace("_gpo", "_pru_r30_out");
						}
						
						if(value.signal === assignmentName){
							alternateModes["register"] = confregisters.register;
							alternateModes["muxMode"] = muxMode.mode;
							alternateModes["fieldPos"] =  value.fieldPos;
							alternateModes["value"] = value.option;
							alternateModes["signal"] = assignmentName;
							
							if(value.hasOwnProperty('additional_option')){
								var additionalOption = {};
								
								additionalOption["fieldPos"] = value.additional_option.fieldPos;
								additionalOption["value"] = value.additional_option.option;
								
								alternateModes["additionalOption"] = additionalOption;
							}
						}
						
					}
				}
			}
		}
	}

	return alternateModes;
};

// function to decompose the register value and return a device tree string
var getDeviceTreeString = function ( modes ){
	
	var regValue = modes[1];
	var deviceTreeRegValueString = "";
	
	// strip leading 0x prefix
	regValue = regValue.replace("0x", '');
	
	// convert to binary
	var regValueBin = parseInt(regValue,16).toString(2);
	
	// pad string with 0s to 32 bits
	while (regValueBin.length < 32 ){
		regValueBin = '0' + regValueBin;
	}
	
	//MUXMODE
	var mumodeBin = regValueBin.substring(28, 32);
	var mumodeString = "MUX_MODE" + parseInt(mumodeBin,2);
	deviceTreeRegValueString = mumodeString;
	
	//VIRTUAL MODE
	var modeSelectBin = regValueBin.substring(23, 24);
	var modeSelectInt = parseInt(modeSelectBin,2);
		
	if (modeSelectInt === 1){
		
		if (isManualModeSet(modes)){
			deviceTreeRegValueString = "MANUAL_MODE" + " | " + deviceTreeRegValueString;
		}else{
			var delayModeBin = regValueBin.substring(24, 28);
			var virtualModeString = "MUX_VIRTUAL_MODE" + parseInt(delayModeBin,2);
			deviceTreeRegValueString = virtualModeString + " | " + deviceTreeRegValueString;
		};
	}
	
	//INPUTENABLE
	var inputeBin = regValueBin.substring(13, 14);
	var inputeInt = parseInt(inputeBin,2);
	
	var directionString = "";
	
	if(inputeInt === 1){
		directionString = "PIN_INPUT";
	}else{
		directionString = "PIN_OUTPUT";
	}
	
	//PULLUDENABLE
	var pullenableBin = regValueBin.substring(15, 16);
	var pullenableInt = parseInt(pullenableBin,2);
	
	if(pullenableInt === 0){
		
		//PULLTYPESELECT
		var pulltypeBin = regValueBin.substring(14, 15);
		var pulltypeInt = parseInt(pulltypeBin,2);
		
		if(pulltypeInt === 0){
			directionString = directionString + "_PULLDOWN";
		}else{
			directionString = directionString + "_PULLUP";
		}
	}
	
	deviceTreeRegValueString = directionString + " | " + deviceTreeRegValueString;
	
	return deviceTreeRegValueString;
};

// function to decompose the manual mode registers value and return a device tree string for manual iodelay config
var getDeviceTreeStringManualMode = function ( modes ){
	
	var regValue = modes[1];
	var deviceTreeRegValueString = "";
	
	// strip leading 0x prefix
	regValue = regValue.replace("0x", '');
	
	// convert to binary
	var regValueBin = parseInt(regValue,16).toString(2);
	
	// pad string with 0s to 32 bits
	while (regValueBin.length < 32 ){
		regValueBin = '0' + regValueBin;
	}
	
	
	//VIRTUAL MODE
	var modeSelectBin = regValueBin.substring(23, 24);
	var modeSelectInt = parseInt(modeSelectBin,2);
		
	if (modeSelectInt === 1){
		
		if (isManualModeSet(modes, false)){
			var modesArray1 = (modes[2].split(", "));
			var modesArray2 = (modes[3].split(", "));
			var modesArray3 = (modes[4].split(", "));
			
			//if there is actual offset export values
			if(modesArray1[0] !== "0x0"){
				deviceTreeRegValueString = "\t\t\t" + modesArray1[0] + " (A_DELAY(" + modesArray1[1] + ") | G_DELAY(" + modesArray1[2] + ")) \t/* " + modesArray1[3] + " */\n";
			}
			if(modesArray2[0] !== "0x0"){
				deviceTreeRegValueString = deviceTreeRegValueString + "\t\t\t" + modesArray2[0] + " (A_DELAY(" + modesArray2[1] + ") | G_DELAY(" + modesArray2[2] + ")) \t/* " + modesArray2[3] + " */\n";
			}
			if(modesArray3[0] !== "0x0"){
				deviceTreeRegValueString = deviceTreeRegValueString + "\t\t\t" + modesArray3[0] + " (A_DELAY(" + modesArray3[1] + ") | G_DELAY(" + modesArray3[2] + ")) \t/* " + modesArray3[3] + " */";
			}
		}
	}
	
	return deviceTreeRegValueString;
};

// function to decompose the manual mode registers value and return a generic format string for manual iodelay config
var getGenericStringManualMode = function ( modes ){
	
	var regValue = modes[1];
	var deviceTreeRegValueString = "";
	
	// strip leading 0x prefix
	regValue = regValue.replace("0x", '');
	
	// convert to binary
	var regValueBin = parseInt(regValue,16).toString(2);
	
	// pad string with 0s to 32 bits
	while (regValueBin.length < 32 ){
		regValueBin = '0' + regValueBin;
	}
	
	
	//VIRTUAL MODE
	var modeSelectBin = regValueBin.substring(23, 24);
	var modeSelectInt = parseInt(modeSelectBin,2);
	
	if (modeSelectInt === 1){
		
		if ((isManualModeSet(modes, true)) && (modes.length > 6)){
		
			var modesArray1 = (modes[6].split(", "));
			var modesArray2 = (modes[7].split(", "));
			var modesArray3 = (modes[8].split(", "));
			
			//if there is actual offset export values
			if(modesArray1[0] !== "0x0"){
				deviceTreeRegValueString = "\t" + modesArray1[0] + "\t" + modesArray1[1] + "\t" + modesArray1[2] + "\t" + modesArray1[3] +"\t" + modes[2] + "\n";
			}
			if(modesArray2[0] !== "0x0"){
				deviceTreeRegValueString = deviceTreeRegValueString + "\t" + modesArray2[0] + "\t" + modesArray2[1] + "\t" + modesArray2[2] + "\t" + modesArray2[3] + "\t" + modes[2] + "\n";
			}
			if(modesArray3[0] !== "0x0"){
				deviceTreeRegValueString = deviceTreeRegValueString + "\t" + modesArray3[0] + "\t" + modesArray3[1] + "\t" + modesArray3[2] + "\t" + modesArray3[3] + "\t" + modes[2] + "\n";
			}
		}
	}
	
	return deviceTreeRegValueString;
};

// function to scan through the 3 IN/OUT/OEN registers and if there is valid offset, we have manual mode configured
var isManualModeSet = function ( modes , isGeneric){
	
	//if function call comes from the generic format, array has different size and offsets are in different cells
	if(isGeneric){
		var modeOffset1 = (modes[6].split(", "))[0];
		var modeOffset2 = (modes[7].split(", "))[0];
		var modeOffset3 = (modes[8].split(", "))[0];
	}else{
		var modeOffset1 = (modes[2].split(", "))[0];
		var modeOffset2 = (modes[3].split(", "))[0];
		var modeOffset3 = (modes[4].split(", "))[0];
	}

	
	//if we have valid offsets (i.e. different than 0x0) we have manual mode values settings.
	if(modeOffset1 !== "0x0" || modeOffset2 !== "0x0" || modeOffset3 !== "0x0"){
		return true;
	}
	
	return false;
}

