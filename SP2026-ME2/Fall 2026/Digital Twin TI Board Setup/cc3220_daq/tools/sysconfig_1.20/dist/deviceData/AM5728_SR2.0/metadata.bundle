function strEndsWith(str, end) {
    return str.match(end+"$")==end;
};

// function to return an array of all associated alternate mode data based on a gived assignment
var getAlternateModes = function (assignment) {
	var alternateModes = {};
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			var muxModes = pad.type.pad.muxmode;
			
			for( var j = 0; j < muxModes.length; j++ ) {
			
				var muxMode = muxModes[j];
				
				if(muxMode.hasOwnProperty('additionalMux')){
					var confregisters = muxMode.additionalMux.confregisters;
					
					var values = confregisters.value;
					if(Array.isArray(values)){
						for(var v = 0; v < values.length; v++){
							
							var value = values[v];
							var assignmentName = assignment.peripheralPin.name;
							
							//patch for pruss gpi/gpo signals mapped to pru_r31/pru_r30 internal signals
							//if found in assignment name replace by internal pruss naming convention
							if((assignmentName.indexOf("_pru") > -1) && (assignmentName.indexOf("_gpi") > -1)){
								assignmentName = assignmentName.replace("_gpi", "_pru_r31_in");
							}else if((assignmentName.indexOf("_pru") > -1) && (assignmentName.indexOf("_gpo") > -1)){
								assignmentName = assignmentName.replace("_gpo", "_pru_r30_out");
							}
							
							if(value.signal === assignmentName){
								alternateModes["register"] = confregisters.register;
								alternateModes["muxMode"] = muxMode.mode;
								alternateModes["fieldPos"] =  value.fieldPos;
								alternateModes["value"] = value.option;
								alternateModes["signal"] = assignmentName;
							
								
								if(value.hasOwnProperty('additional_option')){
									var additionalOption = {};
									
									additionalOption["fieldPos"] = value.additional_option.fieldPos;
									additionalOption["value"] = value.additional_option.option;
									
									alternateModes["additionalOption"] = additionalOption;
								}
							}
							
						}
					}else{
						var value = values;
						var assignmentName = assignment.peripheralPin.name;
						
						//patch for pruss gpi/gpo signals mapped to pru_r31/pru_r30 internal signals
						//if found in assignment name replace by internal pruss naming convention
						if((assignmentName.indexOf("_pru") > -1) && (assignmentName.indexOf("_gpi") > -1)){
							assignmentName = assignmentName.replace("_gpi", "_pru_r31_in");
						}else if((assignmentName.indexOf("_pru") > -1) && (assignmentName.indexOf("_gpo") > -1)){
							assignmentName = assignmentName.replace("_gpo", "_pru_r30_out");
						}
						
						if(value.signal === assignmentName){
							alternateModes["register"] = confregisters.register;
							alternateModes["muxMode"] = muxMode.mode;
							alternateModes["fieldPos"] =  value.fieldPos;
							alternateModes["value"] = value.option;
							alternateModes["signal"] = assignmentName;
							
							if(value.hasOwnProperty('additional_option')){
								var additionalOption = {};
								
								additionalOption["fieldPos"] = value.additional_option.fieldPos;
								additionalOption["value"] = value.additional_option.option;
								
								alternateModes["additionalOption"] = additionalOption;
							}
						}
						
					}
				}
			}
		}
	}

	return alternateModes;
};

var calculateAlternateRegisterValue = function (alternateMode) {
	
	var binaryString = "00000000000000000000000000000000";
	var value = (parseInt(alternateMode.value)).toString(2);
	var position = alternateMode.fieldPos;
	
	// remove colon field separation if any
	if (position.indexOf(':') > -1){
		var split = position.split(':');
		position = split[0];
	}
	position++; // increment by one since we need to start counting from 0
	
	var size = binaryString.length;
	var start = size - position;
	var end =  start + value.length;
	
	binaryString =  binaryString.substring(0, start) + value + binaryString.substring(end, size);

	if(alternateMode.hasOwnProperty("additionalOption")){
	
		var option = alternateMode.additionalOption;
		var value2 = (parseInt(option.value)).toString(2);
		var position2 = option.fieldPos;
		position2++; // increment by one since we need to start counting from 0
		
		var start2 = size - position2;
		var end2 =  start2 + value2.length;
		
		binaryString =  binaryString.substring(0, start2) + value2 + binaryString.substring(end2, size);

	}
	
	return "0x" + ((parseInt(binaryString, 2)).toString(16)).toUpperCase();
};

var getIOSETselected  = function (assignment) {
	var ioset = assignment.ioSet;
	
	ioset = ioset.replace(assignment.peripheral.name, '');
	ioset = ioset.toUpperCase();
	ioset = ioset.replace(/_/g, "");

	return ioset;
};

// function to match current modeName from dictionary vs the additional selected menu item keys,
// if key exists in selectedModes then it is used, so return true 
var isModeSelected  = function (modeNamesKey, selectedModes, assignment) { 
	
	//check for each selected mode
	for(var selectedModeKey in selectedModes){
		
		//if the selected mode key is in modeNamesSelected{}
		if(selectedModeKey in modeNamesSelected){
			//if the corresponding selectedMode value the modetable name
			if(modeNamesSelected[selectedModeKey][0] === modeNamesKey){
				
				//patch for VOUT1/3 where they share same mode name, make sure mode is exported per corresponding instance
				var voutInstances = {"VOUT1":"", "VOUT3":""};
				
				if(assignment.peripheral.name in voutInstances){
					var instanceInselectedModeKey = (((selectedModeKey).split("_"))[0]).toUpperCase();

					if(assignment.peripheral.name === instanceInselectedModeKey){
						return true;
					}
				}else{
					return true;
				}
			}
		}
		
		//if we have IOSETs for the instance
		if(assignment.hasOwnProperty("ioSet")){
			
			//if the selected mode key + IOSET extention is in modeNamesSelected{}
			var selectedModeKeyIOSET = selectedModeKey + "_" + getIOSETselected(assignment);

			if(selectedModeKeyIOSET in modeNamesSelected){
				//if the corresponding selectedMode value the modetable name
				if(modeNamesSelected[selectedModeKeyIOSET][0] === modeNamesKey){
					
					//patch for VOUT1/3 where they share same mode name, make sure mode is exported per corresponding instance
					var voutInstances = {"VOUT1":"", "VOUT3":""};
					
					if(assignment.peripheral.name in voutInstances){
						var instanceInselectedModeKey = (((selectedModeKey).split("_"))[0]).toUpperCase();

						if(assignment.peripheral.name === instanceInselectedModeKey){
							return true;
						}
					}else{
						return true;
					}
				}
			}
			
			//patch for VIN interface which does not have the instance prefixed from use case since it contains only VIN1/2/3/4/5 as prefix
			var vinNames = {"VIN1A":"", "VIN2A":"", "VIN3A":"", "VIN4A":"", "VIN5A":"", "VIN6A":"", "VIN1B":"", "VIN2B":"", "VIN3B":"", "VIN4B":"", "VIN5B":"", "VIN6B":""};
			
			if(assignment.peripheral.name in vinNames){
				
				selectedModeKeyIOSET = selectedModeKeyIOSET.replace(assignment.peripheral.name + "_", '')
				var instance = (((assignment.peripheralPin.name).split("_"))[0]).toUpperCase();
				
				selectedModeKeyIOSET = instance + "_" + selectedModeKeyIOSET;
				
				if(selectedModeKeyIOSET in modeNamesSelected){
					//if the corresponding selectedMode value the modetable name
					if(modeNamesSelected[selectedModeKeyIOSET][0] === modeNamesKey){
						return true;
					}
				}
			}	
		}
		
		//patch for VIN interface which does not have the instance prefixed from use case since it contains only VIN1/2/3/4/5 as prefix
		var vinNames = {"VIN1A":"", "VIN2A":"", "VIN3A":"", "VIN4A":"", "VIN5A":"", "VIN6A":"", "VIN1B":"", "VIN2B":"", "VIN3B":"", "VIN4B":"", "VIN5B":"", "VIN6B":""};
		
		if(assignment.peripheral.name in vinNames){
			
			var selectedModeKeyInstance = selectedModeKey;
			selectedModeKeyInstance = selectedModeKeyInstance.replace(assignment.peripheral.name + "_", '')
			
			var instance = (((assignment.peripheralPin.name).split("_"))[0]).toUpperCase();
			
			selectedModeKeyInstance = instance + "_" + selectedModeKeyInstance;

			if(selectedModeKeyInstance in modeNamesSelected){
				//if the corresponding selectedMode value the modetable name
				if(modeNamesSelected[selectedModeKeyInstance][0] === modeNamesKey){
					return true;
				}
			}
		}
	}
	
	var prussInstances = {"PRUSS1_PRU0":"", "PRUSS1_PRU1":"", "PRUSS2_PRU0":"", "PRUSS2_PRU1":""};

	//patch for PRUss interfaces which does not contain mode selection menu. Desired modes will be taken from use case menu selection.
	if(assignment.peripheral.name in prussInstances){
		
		var peripheralNameString = assignment.peripheral.name;
		var useCaseSelected = assignment.useCase;
		var modesDict = {}
		
		if(useCaseSelected.indexOf("Input") != -1 && useCaseSelected.toLowerCase().indexOf("parallel capture") == -1 && useCaseSelected.toLowerCase().indexOf("bit shift") == -1){
		
			var modeName = peripheralNameString + "_DIR";
			modeName = modeName + "_IN";
			
			//PRUSS2 has IOSET related delays, so append IOSET postfix to the modeName
			if(assignment.peripheral.name.indexOf("PRUSS2") != -1 && assignment.hasOwnProperty("ioSet")){
				modeName = modeName + "_" + getIOSETselected(assignment);	
			}
			
			modesDict[modeName] = "";
			
		}
		if(useCaseSelected.indexOf("Output") != -1 && useCaseSelected.indexOf("Shift out") == -1){
			
			var modeName = peripheralNameString + "_DIR";
			modeName = modeName + "_OUT";
			
			//PRUSS2 has IOSET related delays, so append IOSET postfix to the modeName
			if(assignment.peripheral.name.indexOf("PRUSS2") != -1 && assignment.hasOwnProperty("ioSet")){
				modeName = modeName + "_" + getIOSETselected(assignment);	
			}
			
			modesDict[modeName] = "";
			
		}
		if(useCaseSelected.toLowerCase().indexOf("parallel capture") != -1){
		
			var modeName = peripheralNameString + "_PAR";
			modeName = modeName + "_CAP";
			
			//PRUSS2 has IOSET related delays, so append IOSET postfix to the modeName
			if(assignment.peripheral.name.indexOf("PRUSS2") != -1 && assignment.hasOwnProperty("ioSet")){
				modeName = modeName + "_" + getIOSETselected(assignment);	
			}
			modesDict[modeName] = "";
		}

		for(var modeNameKey in modesDict){
			if(modeNameKey in modeNamesSelected){
			
				if(modeNamesSelected[modeNameKey][0] === modeNamesKey){
					return true;
				}
			}
		}
	}
	
	//patch for GMAC where there is no mode selection menu, and the selection is filtered via the use case menu and hardcoded "default" since only one per instance
	if(assignment.peripheral.name === "GMAC0"){
		if(assignment.useCase === "RMII"){
			if("RMII0_DEFAULT" in modeNamesSelected){
				if(modeNamesSelected["RMII0_DEFAULT"][0] === modeNamesKey){
					return true;
				}
			}
		}else if(assignment.useCase === "RGMII"){
			if("RGMII0_DEFAULT" in modeNamesSelected){
				if(modeNamesSelected["RGMII0_DEFAULT"][0] === modeNamesKey){
					return true;
				}
			}
		}
	}else if(assignment.peripheral.name === "GMAC1"){
		if(assignment.useCase === "RMII"){
			if("RMII1_DEFAULT" in modeNamesSelected){
				if(modeNamesSelected["RMII1_DEFAULT"][0] === modeNamesKey){
					return true;
				}
			}
		}else if(assignment.useCase === "RGMII"){
			if("RGMII1_DEFAULT" in modeNamesSelected){
				if(modeNamesSelected["RGMII1_DEFAULT"][0] === modeNamesKey){
					return true;
				}
			}
		}
	}
	
	//patch for GMAC RMII_MHZ_50_CLK signal in PRCM instance
	if(assignment.peripheral.name === "PRCM"){
		if(assignment.peripheralPin.name === "RMII_MHZ_50_CLK"){
			if("GMAC_RMII0_MANUAL1" === modeNamesKey || "GMAC_RMII1_MANUAL1" === modeNamesKey){
				return true;
			}
		}
	}
	
	//patch for McASP where the modes are exported per each signal based on direction and use case selected
	var mcAspInstances = {"MCASP1":"", "MCASP2":"", "MCASP3":"", "MCASP4":"", "MCASP5":"", "MCASP6":"", "MCASP7":"", "MCASP8":""};
						
	
	if(assignment.peripheral.name in mcAspInstances){
	
		var mcAspInstance = assignment.peripheral.name;
		var signal = (assignment.peripheralPin.interfacePin.name).toUpperCase();
		
		var syncMode;
		var useCaseSelected = assignment.useCase;
		
		if(useCaseSelected.toLowerCase().indexOf("async") != -1){
			syncMode = "ASYNC";
		}else{
			syncMode = "SYNC";
		}
		
		var direction;
		
		if(assignment.hasOwnProperty("transmit")){
			if(assignment.transmit === true){
				direction = "TX";
			}else{
				direction = "RX";
			}
		}else{
			direction = "NA";
		}
		
		
		//get delay mode from big modeMap table based on key settings of the assigned pin
		var currentDelay = "NA";
		
		//if FSX/FSR/AXR need to get the CLKX configuratian the respective delay mode
		if(signal.indexOf("FSX") != -1){
			currentDelay = getMcASPClockDelay(mcAspInstance, syncMode, direction, "ACLKX");
		}else if(signal.indexOf("FSR") != -1){
			currentDelay = getMcASPClockDelay(mcAspInstance, syncMode, direction, "ACLKR");
		}else if(signal.indexOf("AXR") != -1){
			if(direction === "TX"){
				currentDelay = getMcASPClockDelay(mcAspInstance, syncMode, direction, "ACLKX");
			}else if(direction === "RX"){
				currentDelay = getMcASPClockDelay(mcAspInstance, syncMode, direction, "ACLKR");
			}
		}else{
			currentDelay = getMcASPClockDelay(mcAspInstance, syncMode, direction, signal);
		}
		
		
		if(currentDelay === modeNamesKey){
			return true;
		}
	}
	
	var errorMessage = "The selected mode for " + assignment.peripheralPin.name + " is not supported.";
	
	//throw new Error(errorMessage);
	
	return false;
};

//function to loop over assignments to nail down the neeeded McASP clock and return it's delay mode based on current configuration
var getMcASPClockDelay  = function (_mcAspInstance, _syncMode, _direction, _clockName) {
	
	var modeMap = 
				{"MCASP1": 
					{
						"ASYNC": 
						{
							"ACLKX": 
							{
								"TX": "MCASP1_DEFAULT",
								"RX": "MCASP1_VIRTUAL3_ASYNC_RX",
							},
							"ACLKR": 
							{
								"TX": "MCASP1_VIRTUAL1_ASYNC_TX",
								"RX": "MCASP1_VIRTUAL3_ASYNC_RX",
							},
							"AHCLKX": 
							{
								"TX": "NA",
								"RX": "NA",
							},
						},
						"SYNC": 
						{
							"ACLKX": 
							{
								"TX": "MCASP1_DEFAULT",
								"RX": "MCASP1_VIRTUAL2_SYNC_RX",
							},
							"ACLKR": 
							{
								"TX": "NA",
								"RX": "NA",
							},
							"AHCLKX": 
							{
								"TX": "NA",
								"RX": "NA",
							},
						}	
				},
				"MCASP2": 
				{
					"ASYNC": 
					{
						"ACLKX": 
						{
							"TX": "MCASP2_DEFAULT",
							"RX": "MCASP2_VIRTUAL2_ASYNC_RX",
						},
						"ACLKR": 
