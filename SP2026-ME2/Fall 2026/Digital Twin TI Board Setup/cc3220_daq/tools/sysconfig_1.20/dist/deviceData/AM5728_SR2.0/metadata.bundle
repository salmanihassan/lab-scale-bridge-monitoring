var getCamelCasedInstance = function(instance){
	var instanceName;
	switch (instance) {
    case "MMC1":
        instanceName = "Mmc1";
        break;
	case "MMC2":
        instanceName = "Mmc2";
        break;  	
	case "MMC3":
        instanceName = "Mmc3";
        break;  
	case "MMC4":
        instanceName = "Mmc4";
        break;  	
	}
	return instanceName;
};

// function to return an array of all associated manual modes for the selected muxmode
var getManualModes = function (assignment) {
	var manualModes = [];
	
	//console.log (mainDB.length);
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			var muxModes = pad.type.pad.muxmode;
			
			for( var j = 0; j < muxModes.length; j++ ) {
			
				var muxMode = muxModes[j];
				
				if(muxMode.mode === assignment.muxMode){
					
					if(muxMode.hasOwnProperty('manualmode')){
						
						//aways return an array, if not an Array then it is an object so we push it into an array then return
						if(!Array.isArray(muxMode.manualmode)){
							manualModes.push(muxMode.manualmode);	
							return manualModes;
						}
						else{
							return muxMode.manualmode;
						}
					}
				}
			}
		}
	}
	//console.log ("_________________")
	//console.log (mainDB)
	return manualModes;
};

// function to return an array of all associated virtual modes for the selected muxmode
var getVirtualModes = function (assignment) {
	var virtualModes = [];
	
	for( var i = 0; i < mainDB.length; i++ ) {
	
		var pad = mainDB[i];
		
		if(pad.name === assignment.devicePin.designSignalName){
			
			var muxModes = pad.type.pad.muxmode;
			
			for( var j = 0; j < muxModes.length; j++ ) {
			
				var muxMode = muxModes[j];
				
				if(muxMode.mode === assignment.muxMode){
					
					if(muxMode.hasOwnProperty('virtualmode')){
						
						//aways return an array, if not an Array then it is an object so we push it into an array then return
						if(!Array.isArray(muxMode.virtualmode)){
							virtualModes.push(muxMode.virtualmode);	
							return virtualModes;
						}
						else{
							return muxMode.virtualmode;
						}
					}
				}
			}
		}
	}
	
	return virtualModes;
};

var getAddress = function( assignment ) {
	return ( assignment.devicePin.controlRegisterOffset).toString( 16 );
};

var getResetRegisterValue = function ( assignment ){

	var MUXMODE = (parseInt(assignment.muxMode)).toString(16);
	MUXMODE = MUXMODE.toUpperCase();
	var DELAYMODE = "0"; 	//string hex values 0x0 4 bits
	var MODESELECT = "00";  //string hex values 0x00 8 bits (modeselect + reserved bits [8:15])
	var PULLUDENABLE = "0";
	var PULLTYPESELECT = "0";
	var INPUTENABLE = "0";
	var SLEWCONTROL = "0";
	

	if (assignment.pd == false && assignment.pu == false) {
		// if pull up and pull down are not used, set weak pull up/down to 0x1 - disable
		PULLUDENABLE = "1";
	}
	else {
		PULLUDENABLE = "0";
	}
	
	
	
	if (assignment.pd == true){
		PULLTYPESELECT = "0";
	}
	else if(assignment.pu == true){
		PULLTYPESELECT = "1";
	}
	else {
		PULLTYPESELECT = "0";
	}
	
	if (assignment.rx == true){
		INPUTENABLE = "1";
	}
	else if(assignment.rx == false){
		INPUTENABLE = "0";
	}
	
	
	// if offset is one of the 37 register, set to slow slew (0x1)
	if((assignment.devicePin.controlRegisterOffset in slewControlFast) || (assignment.slow_slew_rate == true)){
		SLEWCONTROL = "1";
	}
	
	var PULLstring = SLEWCONTROL + INPUTENABLE + PULLTYPESELECT + PULLUDENABLE;
	var PULLbin = parseInt(PULLstring, 2);
	var PULLhex = PULLbin.toString(16).toUpperCase();
	

	// returning register value MSB first	
	return "0x" + PULLhex + MODESELECT + DELAYMODE + MUXMODE;
}; 

// same as getResetRegisterValue, but needs to calculate muxmode based on alternate muxing (i.e. not the assignment.muxmode which is indexed 17 and higher)
var getResetRegisterValueAltMode = function ( assignment, altMuxMode ){

	var MUXMODE = (parseInt(altMuxMode)).toString(16);
	MUXMODE = MUXMODE.toUpperCase();
	var DELAYMODE = "0"; 	//string hex values 0x0 4 bits
	var MODESELECT = "00";  //string hex values 0x00 8 bits (modeselect + reserved bits [8:15])
	var PULLUDENABLE = "0";
	var PULLTYPESELECT = "0";
	var INPUTENABLE = "0";
	var SLEWCONTROL = "0";
	

	if (assignment.pd == false && assignment.pu == false) {
		// if pull up and pull down are not used, set weak pull up/down to 0x1 - disable
		PULLUDENABLE = "1";
	}
	else {
		PULLUDENABLE = "0";
	}
	
	
	
	if (assignment.pd == true){
		PULLTYPESELECT = "0";
	}
	else if(assignment.pu == true){
		PULLTYPESELECT = "1";
	}
	else {
		PULLTYPESELECT = "0";
	}
	
	if (assignment.rx == true){
		INPUTENABLE = "1";
	}
	else if(assignment.rx == false){
		INPUTENABLE = "0";
	}
	
	
	// if offset is one of the 37 register, set to slow slew (0x1)
	if((assignment.devicePin.controlRegisterOffset in slewControlFast) || (assignment.slow_slew_rate == true)){
		SLEWCONTROL = "1";
	}
	
	var PULLstring = SLEWCONTROL + INPUTENABLE + PULLTYPESELECT + PULLUDENABLE;
	var PULLbin = parseInt(PULLstring, 2);
	var PULLhex = PULLbin.toString(16).toUpperCase();
	

	// returning register value MSB first	
	return "0x" + PULLhex + MODESELECT + DELAYMODE + MUXMODE;
}; 

//same as getResetRegisterValue but MODESELECT bitfield set to "1" as in use manual/virtual mode
var getManualModeRegisterValue = function ( assignment ){

	var MUXMODE = (parseInt(assignment.muxMode)).toString(16);
	MUXMODE = MUXMODE.toUpperCase();
	var DELAYMODE = "0"; 	//string hex values 0x0 4 bits
	var MODESELECT = "01";  //string hex values 0x00 8 bits (modeselect + reserved bits [8:15])
	var PULLUDENABLE = "0";
	var PULLTYPESELECT = "0";
